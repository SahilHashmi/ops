{
  "$schema": "[schemas.wp.org](https://schemas.wp.org/trunk/theme.json)",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "customDuotone": false,
      "palette": [
        {
          "slug": "orange",
          "color": "#F97316",
          "name": "Orange"
        },
        {
          "slug": "orange-dark",
          "color": "#EA580C",
          "name": "Orange Dark"
        },
        {
          "slug": "blue",
          "color": "#2563EB",
          "name": "Blue"
        },
        {
          "slug": "blue-dark",
          "color": "#1D4ED8",
          "name": "Blue Dark"
        },
        {
          "slug": "grey-950",
          "color": "#0B0D12",
          "name": "Grey 950"
        },
        {
          "slug": "grey-900",
          "color": "#111318",
          "name": "Grey 900"
        },
        {
          "slug": "grey-800",
          "color": "#1A1D24",
          "name": "Grey 800"
        },
        {
          "slug": "grey-700",
          "color": "#252932",
          "name": "Grey 700"
        },
        {
          "slug": "grey-500",
          "color": "#687083",
          "name": "Grey 500"
        },
        {
          "slug": "grey-300",
          "color": "#C9CED8",
          "name": "Grey 300"
        },
        {
          "slug": "grey-100",
          "color": "#F2F4F7",
          "name": "Grey 100"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "spacing": {
      "blockGap": false,
      "padding": true,
      "margin": true,
      "units": [
        "px",
        "rem",
        "vw",
        "%"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "1 - Tight",
          "size": "clamp(0.75rem, 1.4vw, 1rem)"
        },
        {
          "slug": "40",
          "name": "2 - Regular",
          "size": "clamp(1.5rem, 3vw, 2.25rem)"
        },
        {
          "slug": "60",
          "name": "3 - Roomy",
          "size": "clamp(2.5rem, 5vw, 4rem)"
        },
        {
          "slug": "80",
          "name": "4 - Section",
          "size": "clamp(4.5rem, 7.5vw, 7.25rem)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "slug": "space-grotesk",
          "name": "Space Grotesk",
          "fontFamily": "'Space Grotesk', 'Inter', 'Segoe UI', system-ui, sans-serif"
        },
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "'Inter', 'Segoe UI', system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.8125rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.125rem",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.25rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "1.75rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          }
        }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--grey-100)",
      "text": "var(--wp--preset--color--grey-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "16px",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--grey-950)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-0.032em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--orange)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--orange)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "0.875rem",
          "fontWeight": "700"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--orange-dark)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontWeight": "700"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "14px",
          "fontWeight": "500"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
